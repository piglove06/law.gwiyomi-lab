# ══════════════════════════════════════════════════════════════
#  법령 조회 도우미 설정
#  이 파일을 .env 로 복사해서 쓰세요. 수정 후에는 서버를 재시작해야 합니다.
# ══════════════════════════════════════════════════════════════


# ══ 로컬 LLM ═════════════════════════════════════════════════
# llama.cpp 의 llama-server 로 돌립니다. start.bat 이 같이 띄웁니다.
#   모델: Qwen3.6-35B-A3B (Q4_K_M) — 12GB VRAM 에서도 빠른 MoE 모델
#   질문 내용이 PC 밖으로 나가지 않고, 사용 한도도 없습니다.
LOCAL_BASE_URL=http://localhost:8080/v1
# llama-server 는 띄울 때 정한 모델 하나만 쓰므로 이 이름은 표시용입니다.
LOCAL_MODEL=Qwen3.6-35B-A3B
# 서버 종류: llamacpp | ollama. 비워두면 주소로 판별(11434 포트면 ollama).
#LOCAL_SERVER=llamacpp
# 응답을 기다릴 최대 시간 (초)
LOCAL_TIMEOUT=300
# 컨텍스트 길이는 보통 llama-server 에서 자동으로 읽습니다.
# 읽지 못할 때만 이 값을 씁니다. start.bat 의 -c 값과 맞추세요.
#LOCAL_CTX=16384

# Ollama 로 돌리려면 위 대신 이렇게 두세요 (모델 이름은 ollama list 에 나오는 것).
#LOCAL_BASE_URL=http://localhost:11434/v1
#LOCAL_MODEL=모델이름

# 사고 과정(Thinking)을 끌지. 1 = 끔 (권장)
# 이 프로그램은 형식 준수가 중요하지 추론이 필요한 작업이 아니라 끄는 편이 훨씬 빠릅니다.
#   llama-server : chat_template_kwargs 로 enable_thinking=false 전송
#   Ollama       : 네이티브 /api/chat 에 think=false 전송
LOCAL_NO_THINK=1

# 1 이면 LLM 프롬프트·응답 원문을 _runs/llm_debug_YYYYMMDD.log 에 남깁니다.
# (콘솔에는 요약만 찍힙니다. 로컬 모델이 형식을 어떻게 어기는지 볼 때 켜세요)
LLM_DEBUG=0


# ══ 출력 토큰 상한 ════════════════════════════════════════════
# 상한이 없으면 모델이 계속 생성합니다.
# 남은 컨텍스트보다 크면 서버가 자동으로 줄여서 보냅니다.
MAXTOK_TERMS=300
MAXTOK_SELECT=400
MAXTOK_CLARIFY=800
MAXTOK_ANSWER=4000


# ══ 접속 ══════════════════════════════════════════════════════
# 이 값만 바꾸면 비밀번호가 바뀝니다. 비우면 로그인 없이 누구나 들어옵니다.
APP_PASSWORD=여기에_비밀번호

# 쿠키 서명용. 아무 긴 문자열이나 넣으세요.
SECRET_KEY=아무거나_길고_랜덤한_문자열


# ══ 법제처 OPEN API ═══════════════════════════════════════════
LAW_OC=발급받은_인증키

# 법령 조회 기준.
#   eflaw : 현행법령(시행일) — 오늘 효력이 있는 조문      ← 기본값
#   law   : 현행법령(공포일) — 공포된 조문
# 개정법이 공포됐지만 시행일이 아직 안 왔으면 둘이 갈립니다.
# 민원 안내는 오늘 효력 있는 조문으로 해야 하므로 eflaw 를 씁니다.
# 시행일 기준으로 조문을 못 받는 법령이 있으면 자동으로 공포일 기준으로
# 되돌리므로 보통은 손댈 일이 없습니다. 문제가 생기면 law 로 바꾸세요.
LAW_TARGET=eflaw

# 자치법규(조례·규칙)를 찾을 지자체.
# 법제처 조례 검색은 다른 지자체 결과까지 섞어 주므로 이 값으로 걸러냅니다.
# v1.31 부터 "전체(auto)" 검색에는 조례가 들어가지 않습니다. 화면에서 대상을
# 조례로 직접 고를 때만 이 값이 쓰입니다.
LOCAL_GOV=성남시


# ══ 검색 동작 ═════════════════════════════════════════════════
# 질문을 다듬기 위해 최대 몇 번까지 되물을지.
# 라운드마다 AI 호출이 1회 늘어납니다. v1.31 기본값 3.
# (조문 조회·용어 정의·일반 기준 질문은 아예 되묻지 않습니다)
CLARIFY_ROUNDS=3

# 되묻기 판단에 넘길 선별 조문 **본문**의 토큰 상한 (v1.31).
# 기준값(용량·기간·횟수)을 보고 보기를 나누려면 본문이 필요합니다.
CLARIFY_CTX_TOKENS=5000
# v1.32 — 별표 본문을 AI 에 넘길 때 글자 상한 (표 테두리·공백 압축 후 기준, 비고는 남김)
BP_CTX_CHARS=3500
# v1.32 — 체계도로 함께 수집할 법령 수 (법률+시행령+시행규칙 묶음 단위). 늘리면 정확도↑ 속도↓
LAW_CANDIDATES=3
# v1.33 — 지능형 검색 1위 법령 점수 비중이 이 값 미만이고 AI 추측과 다르면 "어느 법" 인지 되묻습니다 (0 이면 끔)
LAW_ASK_SHARE=0.5
# v1.33 — 로컬 LLM 이 이 시간(초) 넘게 계속 응답하지 않으면 자동으로 다시 켭니다 (Windows). 끄려면 LLM_AUTO_RESTART=0
LLM_AUTO_RESTART=1
LLM_RESTART_GRACE=180

# LLM 출력 형식을 JSON 으로 강제 (검색어·되묻기·조문 선별). 1=사용.
# 서버가 지원하지 않으면 자동으로 꺼지고 예전 텍스트 방식으로 동작합니다.
LLM_JSON=1

# 조문 선별. 1이면 제목만 먼저 보여주고 필요한 조문만 골라 본문을 넣습니다.
SELECT_ARTICLES=1

# 조문 선별에서 받아들일 최대 개수.
SELECT_MAX=20

# 답변(출력)용으로 남겨 둘 토큰 수.
# 답변 프롬프트에 넣는 조문 분량은 [컨텍스트 − 지시문 − 이 값] 으로 자동 계산됩니다.
# 넘치면 선별 순서가 뒤인 조문부터 통째로 빠지고, 서버 로그에 표시됩니다.
ANSWER_RESERVE=3000
