# ══════════════════════════════════════════════════════════════
#  법령 조회 도우미 설정
#  이 파일을 .env 로 복사해서 쓰세요. 수정 후에는 서버를 재시작해야 합니다.
# ══════════════════════════════════════════════════════════════


# ══ 어느 AI 로 돌릴지 ═════════════════════════════════════════
#
#   옵션 1 — Gemini (기본)      LLM_BACKEND=gemini
#     · 빠르고 정확합니다. 무료 등급은 한도가 있습니다.
#     · 질문 내용이 구글로 전송됩니다. 무료 등급은 제품 개선에 쓰일 수 있습니다.
#
#   옵션 2 — 로컬 (Ollama)      LLM_BACKEND=local
#     · 데이터가 PC 밖으로 나가지 않습니다. 한도도 없습니다.
#     · 느리고, 작은 모델은 형식을 어길 수 있습니다.
#     · Ollama 가 실행 중이어야 합니다 (http://localhost:11434 접속 확인).
#
# 이 한 줄만 바꾸면 네 단계가 모두 전환됩니다.
LLM_BACKEND=gemini

# 단계별로 섞어 쓰고 싶을 때만 주석을 푸세요. 위 값보다 우선합니다.
#   terms   : 일상어 → 법령용어 변환   (쉬움)
#   select  : 조문 제목 보고 고르기     (중간)
#   clarify : 되묻기 판단              (어려움)
#   answer  : 답변 생성                (조·항·호 정확도가 관건)
#LLM_BACKEND_TERMS=local
#LLM_BACKEND_SELECT=local
#LLM_BACKEND_CLARIFY=local
#LLM_BACKEND_ANSWER=local

# 1 이면 프롬프트·응답 전문을 서버 콘솔에 찍습니다.
# 로컬 모델이 형식을 어떻게 어기는지 볼 때 켜세요.
LLM_DEBUG=0


# ══ 옵션 2 : 로컬 LLM 설정 ════════════════════════════════════
# Ollama 는 /v1 경로로 OpenAI 호환 API 를 제공합니다.
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen3.5:9b-q4_K_M
# 로컬은 생성이 느리므로 넉넉히 (초)
LOCAL_TIMEOUT=300

# 사고 과정(Thinking)을 끌지.
# 이 프로그램은 형식 준수가 중요하지 추론이 필요한 작업이 아니라 끄는 편이 훨씬 빠릅니다.
#   1 = Ollama 네이티브 /api/chat 에 think=false 전송 (권장)
#   0 = OpenAI 호환 /chat/completions 사용. Ollama 가 아닌 서버면 이쪽.
LOCAL_NO_THINK=1
# 단계별로 다른 모델을 쓰고 싶을 때만 지정
#LOCAL_MODEL_ANSWER=qwen3.5:9b-q4_K_M


# ══ 출력 토큰 상한 ════════════════════════════════════════════
# 상한이 없으면 모델이 계속 생성합니다.
# 실측: 용어 변환(두 줄이면 충분)에 4,243 토큰 55초를 쓰고 있었습니다.
# 답변이 중간에 잘리면 서버 콘솔에 경고가 뜨니 그때 올리세요.
MAXTOK_TERMS=300
MAXTOK_SELECT=800
MAXTOK_CLARIFY=800
MAXTOK_ANSWER=4000


# ══ 옵션 1 : Gemini 설정 ══════════════════════════════════════
# 쉼표로 여러 개를 넣으면 한도(429)에 걸릴 때 자동으로 다음 키로 넘어갑니다.
#   GEMINI_API_KEY=키1,키2,키3
# ※ 무료 한도는 키가 아니라 "프로젝트" 단위입니다.
#    같은 프로젝트에서 키만 늘리면 한도는 그대로입니다.
GEMINI_API_KEY=여기에_키를_넣으세요

# 한도에 걸린 키를 몇 초 뒤에 다시 시도할지.
# 응답에 retryDelay 가 오면 그 값을 우선하고, 일일 한도면 1시간으로 늘립니다.
GEMINI_KEY_COOLDOWN=15

# ※ /v1beta/models?key=본인키 로 실제 쓸 수 있는 모델을 먼저 확인하세요.
GEMINI_MODEL=gemini-3.6-flash

# 단계별 모델. 비워두면 위 GEMINI_MODEL 을 씁니다.
GEMINI_MODEL_TERMS=gemini-3.5-flash-lite
GEMINI_MODEL_SELECT=gemini-3.5-flash-lite
GEMINI_MODEL_CLARIFY=gemini-3.6-flash
GEMINI_MODEL_ANSWER=gemini-3.6-flash

# 주 모델이 과부하(503)일 때 순서대로 시도할 대체 모델
GEMINI_FALLBACK=gemini-3.5-flash,gemini-2.5-flash


# ══ 접속 ══════════════════════════════════════════════════════
# 이 값만 바꾸면 비밀번호가 바뀝니다. 비우면 로그인 없이 누구나 들어옵니다.
APP_PASSWORD=여기에_비밀번호

# 쿠키 서명용. 아무 긴 문자열이나 넣으세요.
SECRET_KEY=아무거나_길고_랜덤한_문자열


# ══ 법제처 OPEN API ═══════════════════════════════════════════
LAW_OC=발급받은_인증키

# 법령 조회 기준.
#   eflaw : 현행법령(시행일) — 오늘 효력이 있는 조문      ← 기본값
#   law   : 현행법령(공포일) — 공포된 조문
# 개정법이 공포됐지만 시행일이 아직 안 왔으면 둘이 갈립니다.
# 민원 안내는 오늘 효력 있는 조문으로 해야 하므로 eflaw 를 씁니다.
# 시행일 기준으로 조문을 못 받는 법령이 있으면 자동으로 공포일 기준으로
# 되돌리므로 보통은 손댈 일이 없습니다. 문제가 생기면 law 로 바꾸세요.
LAW_TARGET=eflaw

# 자치법규(조례·규칙)를 찾을 지자체.
# 법제처 조례 검색은 다른 지자체 결과까지 섞어 주므로 이 값으로 걸러냅니다.
LOCAL_GOV=성남시


# ══ 검색 동작 ═════════════════════════════════════════════════
# 질문을 다듬기 위해 최대 몇 번까지 되물을지.
# 라운드마다 AI 호출이 1회 늘어납니다. 로컬로 돌릴 때는 3~4 를 권합니다.
CLARIFY_ROUNDS=6

# 되묻기 판단에 넘길 조문 목록 줄 수.
# 로컬 모델은 입력이 길수록 급격히 느려지므로 앞부분만 보여줍니다.
CLARIFY_CATALOG_LINES=60

# 조문 선별. 1이면 제목만 먼저 보여주고 필요한 조문만 골라 본문을 넣습니다.
SELECT_ARTICLES=1

# 답변 생성에 넣을 조문 최대 글자 수.
# 로컬 모델은 컨텍스트가 길수록 느려지고 앞부분을 놓칩니다.
#   Gemini : 60000 정도 /  로컬 : 20000 ~ 30000 권장
CONTEXT_LIMIT=60000
